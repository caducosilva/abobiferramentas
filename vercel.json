{
  "trailingSlash": false,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/apps-android-open-source", "destination": "/", "permanent": true },
    { "source": "/apk-open-source", "destination": "/", "permanent": true },
    { "source": "/apps-android", "destination": "/", "permanent": true },
    { "source": "/baixar-apk", "destination": "/", "permanent": true },
    { "source": "/baixador-de-videos", "destination": "/", "permanent": true },
    { "source": "/baixar-video-instagram", "destination": "/", "permanent": true },
    { "source": "/baixar-videos", "destination": "/", "permanent": true },
    { "source": "/video-downloader", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/horarios-de-onibus-mogi", "destination": "/horarios-de-onibus-mogi/index.html" },
    { "source": "/horarios-de-onibus-sp", "destination": "/horarios-de-onibus-sp/index.html" },
    { "source": "/horarios-de-onibus-fortaleza", "destination": "/horarios-de-onibus-fortaleza/index.html" },
    { "source": "/horarios-de-onibus-ceara", "destination": "/horarios-de-onibus-ceara/index.html" },
    { "source": "/formatador-de-json", "destination": "/formatador-de-json/index.html" },
    { "source": "/formatador-de-sql", "destination": "/formatador-de-sql/index.html" },
    { "source": "/conversor-json-yaml-csv", "destination": "/conversor-json-yaml-csv/index.html" },
    { "source": "/testador-de-regex", "destination": "/testador-de-regex/index.html" },
    { "source": "/decodificador-de-jwt", "destination": "/decodificador-de-jwt/index.html" },
    { "source": "/conversor-de-cores", "destination": "/conversor-de-cores/index.html" },
    { "source": "/gerador-de-dados-mock-faker", "destination": "/gerador-de-dados-mock-faker/index.html" },
    { "source": "/gerador-de-meta-tags-seo", "destination": "/gerador-de-meta-tags-seo/index.html" },
    { "source": "/formatador-de-xml", "destination": "/formatador-de-xml/index.html" },
    { "source": "/comparador-de-textos", "destination": "/comparador-de-textos/index.html" },
    { "source": "/gerador-de-uuid", "destination": "/gerador-de-uuid/index.html" },
    { "source": "/base64-e-hash", "destination": "/base64-e-hash/index.html" },
    { "source": "/gerador-de-senha", "destination": "/gerador-de-senha/index.html" },
    { "source": "/gerador-de-cpf", "destination": "/gerador-de-cpf/index.html" },
    { "source": "/validador-de-cpf", "destination": "/validador-de-cpf/index.html" },
    { "source": "/gerador-de-cnpj", "destination": "/gerador-de-cnpj/index.html" },
    { "source": "/gerador-de-qr-code", "destination": "/gerador-de-qr-code/index.html" },
    { "source": "/gerador-de-pix-copia-e-cola", "destination": "/gerador-de-pix-copia-e-cola/index.html" },
    { "source": "/contador-de-texto", "destination": "/contador-de-texto/index.html" },
    { "source": "/limpador-de-metadados-de-fotos", "destination": "/limpador-de-metadados-de-fotos/index.html" },
    { "source": "/conversor-de-imagem", "destination": "/conversor-de-imagem/index.html" },
    { "source": "/compressor-de-imagem", "destination": "/compressor-de-imagem/index.html" },
    { "source": "/consulta-de-cep", "destination": "/consulta-de-cep/index.html" },
    { "source": "/cofre-de-notas-local", "destination": "/cofre-de-notas-local/index.html" },
    { "source": "/calculadora-de-datas", "destination": "/calculadora-de-datas/index.html" },
    { "source": "/calculadora-de-porcentagem-e-imc", "destination": "/calculadora-de-porcentagem-e-imc/index.html" },
    { "source": "/conversor-de-unidades", "destination": "/conversor-de-unidades/index.html" },
    { "source": "/gerador-de-link-whatsapp", "destination": "/gerador-de-link-whatsapp/index.html" },
    { "source": "/gerador-de-curriculo", "destination": "/gerador-de-curriculo/index.html" },
    { "source": "/sobre", "destination": "/sobre/index.html" },
    { "source": "/contato", "destination": "/contato/index.html" },
    { "source": "/conformidade-legal", "destination": "/conformidade-legal/index.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
